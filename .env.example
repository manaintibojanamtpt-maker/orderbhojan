# OrderBhojan — local development (MSW mock mode)
VITE_APP_ENV=development
VITE_MARKETPLACE_API_URL=
VITE_MSW_ENABLED=true
VITE_ANALYTICS_ENABLED=true
VITE_API_TIMEOUT_MS=30000
VITE_API_RETRY_ATTEMPTS=2
VITE_API_RETRY_DELAY_MS=500

# Firebase — required for auth + push in production
# When keys are omitted at build time, OrderBhojan fetches /api/client-config on boot.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=orderbhojan
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# Phone OTP (Firebase reCAPTCHA — configure in Firebase console)
VITE_RECAPTCHA_SITE_KEY=

# Razorpay (checkout online payments)
VITE_RAZORPAY_KEY_ID=

# Feature flags (default OFF — mock/placeholder UX)
VITE_FF_OB_DISCOVERY=false
VITE_FF_OB_SEARCH=false
VITE_FF_OB_RESTAURANT=false
VITE_FF_OB_MENU=false
VITE_FF_OB_CONTRACT_V1=false
VITE_FF_OB_FIRESTORE=false
VITE_FF_OB_TRACKING=false
VITE_FF_OB_NOTIFICATIONS=false
VITE_FF_OB_PAYMENTS=false
VITE_FF_OB_PROMOTIONS=false
VITE_FF_LOCATION_ENABLED=false
VITE_FF_LOCATION_GEOCODE_API=false
VITE_FF_LOCATION_MAP_ENABLED=false
# Shared AI consumer assistant (web + Android) — OFF; never put OpenRouter keys in Vite
VITE_FF_OB_AI_ASSISTANT=false
# AI voice capture hooks — OFF; also requires FF_OB_AI_ASSISTANT for assist calls
VITE_FF_OB_AI_VOICE=false
# Optional TTS confirmation after voice assist — OFF
VITE_FF_OB_AI_VOICE_TTS=false
# Post-order / order-status assist hooks — OFF; also requires FF_OB_AI_ASSISTANT
VITE_FF_OB_AI_POST_ORDER=false
# Personalized reorder / favorites guidance — OFF; also requires FF_OB_AI_ASSISTANT
VITE_FF_OB_AI_PERSONALIZATION=false
# Deterministic canary cohort headers on AI calls — OFF; no UI change when enabled
VITE_FF_OB_AI_CANARY_HEADERS=false
# Voice-core confirm/add progressive rollout — kill switch OFF by default
VITE_FF_OB_AI_VOICE_CORE_CONFIRM_ADD=false
# Sticky percent cohort 0–100 (0 = internal allowlist only). Ramp: 1 → 5 → 10 → 25 → 100
VITE_OB_VOICE_CORE_CONFIRM_ADD_PCT=0
# Comma-separated internal emails for smallest cohort (no PII in logs)
# VITE_OB_VOICE_CORE_CONFIRM_ADD_INTERNAL_EMAILS=you@example.com

VITE_MARKETPLACE_API_PROXY=http://localhost:8081
VITE_MARKETPLACE_API_VERSION=1.0
VITE_APP_CHECK_ENABLED=false

# --- Live Firestore local stack (copy to .env.local) ---
# VITE_FF_OB_FIRESTORE=true
# VITE_MSW_ENABLED=false
# VITE_MARKETPLACE_API_PROXY=http://localhost:8081
# VITE_FIREBASE_PROJECT_ID=bhojanos-prod
# VITE_FIREBASE_AUTH_DOMAIN=bhojanos-prod.firebaseapp.com
# VITE_FIREBASE_STORAGE_BUCKET=bhojanos-prod.firebasestorage.app
# VITE_FIREBASE_API_KEY=<your-web-api-key>
# VITE_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
# VITE_FIREBASE_APP_ID=<app-id>
# VITE_FIREBASE_VAPID_KEY=<web-push-vapid-key>
# VITE_RAZORPAY_KEY_ID=<razorpay-key>
#
# Backend (repo root, separate terminal):
#   PORT=8081
#   FIREBASE_PROJECT_ID=bhojanos-prod
#   GOOGLE_APPLICATION_CREDENTIALS=<path-to-service-account.json>
#   npm run dev
#
# OrderBhojan:
#   npm run dev -- --port 5180

# --- Production live stack (bhojanos-prod — Vercel / orderbhojan.com) ---
# REQUIRED for production Firestore sync against BhojanOS API + Firebase.
# VITE_APP_ENV=production
# VITE_FF_OB_FIRESTORE=true
# VITE_MSW_ENABLED=false
# VITE_MARKETPLACE_API_PROXY=https://manaintibojanam-backend.onrender.com
# VITE_FIREBASE_PROJECT_ID=bhojanos-prod
# VITE_FIREBASE_AUTH_DOMAIN=bhojanos-prod.firebaseapp.com
# VITE_FIREBASE_STORAGE_BUCKET=bhojanos-prod.firebasestorage.app
# VITE_FIREBASE_API_KEY=<optional — bootstrapped via GET /api/client-config if omitted>
# VITE_FIREBASE_MESSAGING_SENDER_ID=<optional — bootstrapped via /api/client-config>
# VITE_FIREBASE_APP_ID=<optional — bootstrapped via /api/client-config>
# VITE_FIREBASE_VAPID_KEY=<web-push-vapid-key>
# VITE_RAZORPAY_KEY_ID=<razorpay-key>
#
# Render (bhojanos-prod-api) must expose FIREBASE_WEB_API_KEY + FIREBASE_WEB_APP_ID
# (or VITE_FIREBASE_* equivalents) so /api/client-config returns configured: true.
