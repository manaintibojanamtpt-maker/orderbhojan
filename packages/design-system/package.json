{
  "name": "@bhojan/design-system",
  "version": "1.1.0-px2",
  "private": true,
  "description": "Bhojan Design System (BDS) — official visual language for the Bhojan ecosystem",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles/bds.css"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "prepare": "npm run build",
    "build": "tsc --project tsconfig.build.json && node scripts/build-css.mjs",
    "build:storybook": "storybook build -o storybook-static",
    "lint": "eslint src && tsc --noEmit",
    "test:unit": "node --import tsx --test tests/**/*.test.ts",
    "test:a11y": "node --import tsx tests/a11y-smoke.mjs",
    "gate:bds": "node scripts/gate-bds.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.14",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.4.3"
  }
}
