# OrderBhojan — production / Capacitor APK builds (`vite build` → `cap:sync`)
# Overrides .env so Android never bakes http://localhost as the marketplace API.
VITE_APP_ENV=production
VITE_MSW_ENABLED=false
VITE_ANALYTICS_ENABLED=true
VITE_API_TIMEOUT_MS=30000
VITE_API_RETRY_ATTEMPTS=2
VITE_API_RETRY_DELAY_MS=500

VITE_MARKETPLACE_API_URL=https://manaintibojanam-backend.onrender.com
VITE_MARKETPLACE_API_PROXY=https://manaintibojanam-backend.onrender.com
VITE_MARKETPLACE_API_VERSION=1.0
VITE_APP_CHECK_ENABLED=false

# Live Firestore / marketplace (prod defaults also force these when unset)
VITE_FF_OB_FIRESTORE=true
VITE_FF_OB_DISCOVERY=true
VITE_FF_OB_SEARCH=true
VITE_FF_OB_RESTAURANT=true
VITE_FF_OB_MENU=true
VITE_FF_OB_CONTRACT_V1=true
VITE_FF_OB_TRACKING=true
VITE_FF_OB_NOTIFICATIONS=true
VITE_FF_OB_PAYMENTS=true
VITE_FF_LOCATION_ENABLED=true
VITE_FF_LOCATION_GEOCODE_API=true
VITE_FF_LOCATION_MAP_ENABLED=false
VITE_FF_OB_PROMOTIONS=false

# AI voice waiter (Android Telugu — prefer native STT)
VITE_FF_OB_AI_ASSISTANT=true
VITE_FF_OB_AI_VOICE=true
VITE_FF_OB_AI_VOICE_TTS=true
VITE_FF_OB_AI_CLOUD_TTS=true
VITE_FF_OB_VOICE_STREAMING=true
VITE_FF_OB_AI_NATIVE_STT=true
VITE_FF_OB_AI_POST_ORDER=false
VITE_FF_OB_AI_PERSONALIZATION=false
VITE_FF_OB_AI_CANARY_HEADERS=false
VITE_FF_OB_AI_VOICE_CORE_CONFIRM_ADD=true
VITE_OB_VOICE_CORE_CONFIRM_ADD_PCT=0

VITE_FF_NATIVE_HOST=false
VITE_FF_NATIVE_TRACK=false
VITE_OB_NATIVE_TRACK_PCT=0

# Firebase — same project as local .env; client-config can still hydrate missing keys
VITE_FIREBASE_API_KEY=AIzaSyC6kCJwsEWuwLVPGmJsVDDxTyWlayp2yLQ
VITE_FIREBASE_AUTH_DOMAIN=bhojanos-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bhojanos-prod
VITE_FIREBASE_STORAGE_BUCKET=bhojanos-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=170989397954
VITE_FIREBASE_APP_ID=1:170989397954:web:9c67dbacc58329f360185b
